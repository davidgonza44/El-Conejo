# Copiar este archivo a .env y completar con las credenciales locales.
# Docker: NO copie ni sustituya el .env local. Use docker_support/make_env.py
# para generar .env.docker (desechable) y .env.demo (demostración separada).
# Consulte docs/DOCKER.md. Seleccione --env-file o COMPOSE_ENV_FILES.
# Variables adicionales de contenedor, todas generadas sin credenciales fijas:
# COMPOSE_PROJECT_NAME, DOCKER_ENV_KIND, ENVIRONMENT_ID, APP_PORT,
# MARIADB_ROOT_PASSWORD, SECRETS_ENCRYPTION_KEY, ADMIN_USERNAME, DEMO_MODE.
# Dentro de Docker: DB_HOST=db, DB_PORT=3306, APP_ENV=production.

# Clave secreta de Flask (sesiones). Generar una propia para producción.
SECRET_KEY=change-me

# Conexión a MariaDB (los cortes de conciliación lo requieren; Docker fija 10.11.14)
DB_HOST=localhost
DB_PORT=3306
DB_USER=app_user
DB_PASSWORD=change-me
DB_NAME=inventory_database

# Credenciales del usuario administrador inicial (datos semilla)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# Entorno: development | production
# En development el token passwordless se muestra en la respuesta (solo pruebas).
APP_ENV=development

# Minutos de vigencia del token de login passwordless
PASSWORDLESS_TOKEN_MINUTES=15

# Login con Google (OpenID Connect).
# Crear credenciales OAuth 2.0 en https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback

# --- Correo saliente (SMTP) ---
# MAIL_ENABLED=false: no se envía correo real; en development los flujos
# devuelven dev_token / dev_reset_link para probar sin SMTP.
# Para Gmail: activar verificación en 2 pasos y crear una contraseña de
# aplicación en https://myaccount.google.com/apppasswords
MAIL_ENABLED=false
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=your-email@example.com
MAIL_PASSWORD=your-app-password
MAIL_DEFAULT_SENDER=your-email@example.com
MAIL_FROM_NAME=Ferretería El Conejo

# URL base pública para armar los enlaces enviados por correo
APP_BASE_URL=http://localhost:5000

# Minutos de vigencia del enlace de recuperación de contraseña
PASSWORD_RESET_TOKEN_MINUTES=30
